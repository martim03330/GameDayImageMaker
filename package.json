{
  "name": "gameday-image-maker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint",
    "sync": "tsx scripts/resync.ts",
    "test": "vitest run",
    "build:prod": "NEXT_DIST_DIR=.next-prod next build",
    "start:prod": "NEXT_DIST_DIR=.next-prod next start -p 3100",
    "dev:test": "NO_BACKGROUND=1 next dev -p 3101",
    "deploy": "npm run build:prod && (lsof -ti :3100 | xargs kill 2>/dev/null; sleep 1; NEXT_DIST_DIR=.next-prod nohup next start -p 3100 > /tmp/gameday-prod.log 2>&1 &)"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "nanoid": "^6.0.1",
    "next": "15.5.25",
    "playwright": "^1.63.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
